local function rescanTargets()
    local t = {}
    local pCharSet = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            pCharSet[p.Character] = true
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and head and hrp then
                table.insert(t, { model=p.Character, head=head, hrp=hrp, hum=hum, name=p.Name, isPlayer=true, player=p })
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not pCharSet[obj] then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local head = obj:FindFirstChild("Head")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and head and hrp then
                table.insert(t, { model=obj, head=head, hrp=hrp, hum=hum, name=obj.Name, isPlayer=false })
            end
        end
    end
    TargetCache.targets = t
    TargetCache.lastScan = tick()
end

local function getSelectedTargetData()
    if not ST.selectedTarget then return nil end
    for _, t in ipairs(TargetCache.targets) do
        if (t.isPlayer and t.player == ST.selectedTarget) or (not t.isPlayer and t.model == ST.selectedTarget) then
            return t
        end
    end
    return nil
end

local function getAimPart(t)
    if ST.aimPart == "Body" then return t.hrp else return t.head end
end

