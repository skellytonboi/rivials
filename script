    fl.BackgroundColor3 = T.NEON
    fl.BorderSizePixel = 0
    Instance.new("UICorner", fl).CornerRadius = UDim.new(1, 0)

    local grab = Instance.new("TextButton", tr)
    grab.Size = UDim2.new(1, 0, 0, 20)
    grab.Position = UDim2.new(0, 0, 0.5, -10)
    grab.BackgroundTransparency = 1
    grab.Text = ""

    local drg = false
    grab.MouseButton1Down:Connect(function() drg = true end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drg = false end end)
    UIS.InputChanged:Connect(function(i)
        if drg and i.UserInputType == Enum.UserInputType.MouseMovement then
            local r = math.clamp((i.Position.X - tr.AbsolutePosition.X) / math.max(1, tr.AbsoluteSize.X), 0, 1)
            local val = math.floor(mn + r * (mx - mn))
            fl.Size = UDim2.new(r, 0, 1, 0)
            v.Text = tostring(val)
            cb(val)
        end
    end)
end

