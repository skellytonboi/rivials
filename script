local function mkCard(par, order, h, bg)
    local c = Instance.new("Frame", par)
    c.Size = UDim2.new(1, 0, 0, h or 40)
    c.BackgroundColor3 = bg or T.CC
    c.BorderSizePixel = 0
    c.LayoutOrder = order
    Instance.new("UICorner", c).CornerRadius = UDim.new(0, 8)
    return c
end

local function mkSec(par, title, order)
    local f = Instance.new("Frame", par)
    f.Size = UDim2.new(1, 0, 0, 20)
    f.BackgroundTransparency = 1
    f.LayoutOrder = order
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.fromScale(1, 1)
    l.BackgroundTransparency = 1
    l.Text = title
    l.TextColor3 = T.DIM
    l.Font = Enum.Font.GothamBold
    l.TextSize = 10
    l.TextXAlignment = Enum.TextXAlignment.Left
end

local function mkTog(par, title, order, getter, setter)
    local c = mkCard(par, order, 36)
    local l = Instance.new("TextLabel", c)
    l.Position = UDim2.fromOffset(10, 0)
    l.Size = UDim2.new(1, -60, 1, 0)
    l.BackgroundTransparency = 1
    l.Text = title
    l.TextColor3 = T.TEXT
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left

    local on = getter()
    local pill = Instance.new("Frame", c)
    pill.Size = UDim2.fromOffset(36, 20)
    pill.Position = UDim2.new(1, -46, 0.5, -10)
    pill.BackgroundColor3 = on and T.NEON or T.POFF
    pill.BorderSizePixel = 0
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame", pill)
    knob.Size = UDim2.fromOffset(16, 16)
    knob.Position = on and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton", c)
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.MouseButton1Click:Connect(function()
        setter(not getter())
        local state = getter()
        TS:Create(pill, TweenInfo.new(0.15), {BackgroundColor3 = state and T.NEON or T.POFF}):Play()
        TS:Create(knob, TweenInfo.new(0.15), {Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)}):Play()
    end)
end

