-- ================================================================
local function canSee(pos)
    if not ST.wallCheck then return true end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = { LP.Character }
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local ray = workspace:Raycast(Camera.CFrame.Position, (pos - Camera.CFrame.Position), rp)
    return ray == nil
end

local function aimAt(pos)
    local camPos = Camera.CFrame.Position
    Camera.CFrame = CFrame.lookAt(camPos, pos)
    local char = LP.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local flat = Vector3.new(pos.X - hrp.Position.X, 0, pos.Z - hrp.Position.Z)
            if flat.Magnitude > 0.1 then
                hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + flat.Unit)
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if fovCircle then
        local vp = Camera.ViewportSize
        fovCircle.Position = Vector2.new(vp.X/2, vp.Y/2)
        fovCircle.Visible = ST.aimbot and ST.fovCircleEnabled and (not ST.holdKeyMode or UIS:IsKeyDown(ST.holdKeybind))
    end

    if tick() - TargetCache.lastScan > 0.15 then rescanTargets() end

    local isAiming = ST.aimbot and (not ST.holdKeyMode or UIS:IsKeyDown(ST.holdKeybind))
    if not isAiming then return end

    local mode = ST.aimMode
    local target = nil

    if mode == "ShootThenLock" then
        if Sticky.lockedModel and Sticky.lockedModel.Parent then
            target = getSelectedTargetData() -- reuse selector to get data if locked
            if target and target.model ~= Sticky.lockedModel then target = nil end
            if not target then 
                for _, t in ipairs(TargetCache.targets) do if t.model == Sticky.lockedModel then target = t break end end
            end
        end
    elseif mode == "Regular" or mode == "SoftLock" then
        local center = Camera.ViewportSize / 2
        local best, bDist = nil, math.huge
        for _, t in ipairs(TargetCache.targets) do
            if t.hum.Health > 0 and t.head.Parent then
                local sp, on = Camera:WorldToScreenPoint(t.head.Position)
                if on and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < ST.fovRadius and d < bDist and canSee(t.head.Position) then
                        bDist = d; best = t
                    end
                end
            end
        end
        target = best
    elseif mode == "HardBot" then
        -- uses ST.hardBotTarget
        for _, t in ipairs(TargetCache.targets) do
            if t.isPlayer and t.player == ST.hardBotTarget then target = t; break end
        end
    end

    if target then
        local part = getAimPart(target)
        if canSee(part.Position) then
            if mode == "SoftLock" then
                local camPos = Camera.CFrame.Position
                local lerpAmt = math.clamp(ST.softLockStrength / 100, 0.01, 1) * 0.15
                local blended = Camera.CFrame.LookVector:Lerp((part.Position - camPos).Unit, lerpAmt)
                Camera.CFrame = CFrame.lookAt(camPos, camPos + blended)
            else
                aimAt(part.Position)
            end
            if ST.autoShoot then
                if mouse1click then mouse1click() end
            end
        end
    end
end)

